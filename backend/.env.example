# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Full PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_image_gen"


# ============================================================
# IMAGE PROVIDER SELECTION
# ============================================================

# Choose which AI provider to use for image generation.
# Options: openai | gemini | stability | huggingface | replicate | bedrock | azure
IMAGE_PROVIDER="openai"


# ============================================================
# OPENAI CONFIGURATION
# ============================================================

# Get your OpenAI API key here:
# https://platform.openai.com/account/api-keys
OPENAI_API_KEY=""

# OpenAI image model (recommended):
# https://platform.openai.com/docs/guides/images
OPENAI_IMAGE_MODEL="gpt-image-1"


# ============================================================
# GOOGLE GEMINI CONFIGURATION
# ============================================================

# Get your Gemini API key here:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini image model:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_IMAGE_MODEL="gemini-2.0-flash-preview-image-generation"


# ============================================================
# STABILITY AI CONFIGURATION (Stable Diffusion)
# ============================================================

# Get your Stability AI API key here:
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=""

# Stability AI image model note:
# Stable Image Core uses the Stability API; no separate model ID is required here.


# ============================================================
# HUGGINGFACE INFERENCE API CONFIGURATION
# ============================================================

# Get your HuggingFace API key here:
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# HuggingFace model ID (SDXL example):
# https://huggingface.co/models
HUGGINGFACE_IMAGE_MODEL="stabilityai/stable-diffusion-xl-base-1.0"


# ============================================================
# REPLICATE API CONFIGURATION
# ============================================================

# Get your Replicate API key here:
# https://replicate.com/account/api-tokens
REPLICATE_API_KEY=""

# Replicate model (Flux Schnell example):
# https://replicate.com/black-forest-labs/flux-schnell
REPLICATE_IMAGE_MODEL="black-forest-labs/flux-schnell"


# ============================================================
# AWS BEDROCK (Amazon Titan Image Generator)
# ============================================================

# Console: https://console.aws.amazon.com/bedrock/home
# Use IAM keys or the default AWS credential chain (instance role, SSO, etc.).
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional temporary session token:
AWS_SESSION_TOKEN=""

# Titan Image Generator v2:
# https://docs.aws.amazon.com/bedrock/latest/userguide/model-parameters-titan-image.html
BEDROCK_IMAGE_MODEL="amazon.titan-image-generator-v2:0"


# ============================================================
# AZURE OPENAI (Microsoft Foundry)
# ============================================================

# Portal: https://portal.azure.com (search “Azure OpenAI Service”)
AZURE_OPENAI_API_KEY=""
# Example: https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
# Deployment name for a gpt-image-* model (not the display name)
AZURE_OPENAI_DEPLOYMENT="gpt-image-1"


# ============================================================
# IMAGE GENERATION SETTINGS
# ============================================================

# Image output size (supported by most providers)
IMAGE_SIZE="1024x1024"


# ============================================================
# FRONTEND / CORS CONFIGURATION
# ============================================================

# Allowed frontend origin (Vite default dev server)
CORS_ORIGINS="*"
# CORS_ORIGINS="http://localhost:5173,http://192.168.1.43:5173,http://192.168.1.43:8000"


# ============================================================
# HTTPS REDIRECTION
# ============================================================

# Enable HTTPS redirect in production (true/false)
ENABLE_HTTPS_REDIRECT="false"


# ============================================================
# AUTH / SESSIONS
# ============================================================

# How long a signed-in session stays valid (days)
AUTH_SESSION_DAYS="7"
