{
  "name": "ai-image-gen-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the AI Image Generator using FastAPI and Prisma ORM",
  "author": "Nditah <nditah@gmail.com>",
  "license": "MIT",

  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "python3 prisma/seed.py"
  },

  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:seed": "python3 prisma/seed.py"
  }
}
