generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PromptLog {
  id          Int      @id @default(autoincrement())
  sessionId   String
  promptText  String
  imageBase64 String
  provider    String
  createdAt   DateTime @default(now())
}
