# Use stable Python image
FROM python:3.11-slim

# Install system dependencies required by Prisma + PostgreSQL + AI providers
RUN apt-get update && apt-get install -y \
    curl \
    bash \
    openssl \
    libssl-dev \
    libpq-dev \
    gcc \
    g++ \
    make \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Prisma CLI (Prisma 5)
RUN curl -fsSL https://prisma.sh/cli | sh


# Set working directory
WORKDIR /app

# Copy requirements first for caching
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy backend code
COPY backend /app

# Generate Prisma client
RUN prisma generate --schema=/app/prisma/schema.prisma

# Expose FastAPI port
EXPOSE 8000

# Run FastAPI with Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
